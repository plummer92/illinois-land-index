{
  "periods": [
    "2025-08",
    "2026-08"
  ],
  "metrics": {
    "collections_rate": {
      "label": "Debt in collections",
      "unit": "rate",
      "definition": "Share of people with a credit record showing a collection account.",
      "source_column": "totcoll"
    },
    "median_collections_debt": {
      "label": "Median debt in collections",
      "unit": "usd",
      "definition": "Middle dollar amount among people whose credit records show debt in collections.",
      "source_column": "totcollpos_p50"
    },
    "credit_card_delinquency_rate": {
      "label": "Credit card delinquency",
      "unit": "rate",
      "definition": "Share of people carrying credit or charge card debt who are at least 60 days late.",
      "source_column": "carddelrate"
    },
    "median_credit_card_delinquent_debt": {
      "label": "Median delinquent credit card debt",
      "unit": "usd",
      "definition": "Middle amount in delinquent credit or charge card debt among people with a delinquent card.",
      "source_column": "carddelpos_p50"
    },
    "auto_retail_delinquency_rate": {
      "label": "Auto or retail loan delinquency",
      "unit": "rate",
      "definition": "Share of auto loan, auto lease or retail installment borrowers who are at least 60 days late.",
      "source_column": "autoretdelrate"
    },
    "share_with_auto_loans": {
      "label": "People with an auto loan or lease",
      "unit": "rate",
      "definition": "Share of people with a credit record who have an auto loan or vehicle lease.",
      "source_column": "autoopen"
    },
    "share_with_auto_retail_debt": {
      "label": "People with auto or retail debt",
      "unit": "rate",
      "definition": "Share of people with a credit record who have an auto loan, auto lease or retail installment loan.",
      "source_column": "autoretopen"
    },
    "student_loan_delinquency_rate": {
      "label": "Student loan delinquency",
      "unit": "rate",
      "definition": "Share of student borrowers whose loans are in default or at least 60 days late.",
      "source_column": "stddelderogofstdtot"
    },
    "share_with_student_loan_debt": {
      "label": "People with student debt",
      "unit": "rate",
      "definition": "Share of people with a credit record showing student debt, including deferred and delinquent accounts.",
      "source_column": "stdtot"
    },
    "median_student_loan_debt": {
      "label": "Median student loan debt",
      "unit": "usd",
      "definition": "Middle student debt balance among people who have student loans.",
      "source_column": "stdtotpos_p50"
    },
    "median_monthly_student_loan_payment": {
      "label": "Median monthly student payment",
      "unit": "usd",
      "definition": "Middle monthly payment owed by people who have open student loan accounts.",
      "source_column": "stdmonthpos_p50"
    }
  },
